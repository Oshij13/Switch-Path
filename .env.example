# Local backend only. Never expose this value to the browser or Chrome extension.
OPENAI_API_KEY=
SWITCHPATH_AGENT_MODEL=gpt-5.6-luna
SWITCHPATH_REASONING_EFFORT=low

# Added when the Supabase repository is connected.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SWITCHPATH_DEMO_USER_ID=00000000-0000-4000-8000-000000000002
SWITCHPATH_DEMO_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
SWITCHPATH_DEMO_PLAYBOOK_VERSION_ID=00000000-0000-4000-8000-000000000004
SWITCHPATH_WORKER_ID=switchpath-local-worker
SWITCHPATH_WORKER_POLL_MS=1000
SWITCHPATH_API_HOST=127.0.0.1
SWITCHPATH_API_PORT=4317

# Production authentication and multi-user execution.
SWITCHPATH_REQUIRE_AUTH=false
SWITCHPATH_INTERNAL_AUTH_SECRET=
SWITCHPATH_WEB_ORIGINS=
SWITCHPATH_MULTI_USER=false

# Frontend build/runtime. Set to the public API origin when hosted.
NEXT_PUBLIC_SWITCHPATH_API_BASE=http://127.0.0.1:4317

# Optional. Switchpath automatically finds the bundled local Python runtime when omitted.
SWITCHPATH_PYTHON_BIN=
