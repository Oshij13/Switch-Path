{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "typeRoots": ["./apps/web/node_modules/@types"]
  },
  "include": [
    "packages/shared/src/**/*.ts",
    "packages/agent/src/**/*.ts",
    "packages/database/src/**/*.ts",
    "apps/api/src/**/*.ts",
    "apps/worker/src/**/*.ts"
  ]
}
